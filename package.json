{
  "name": "reventex",
  "version": "0.2.0",
  "description": "Full stack State Manager for TypeScript",
  "main": "lib/index.js",
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "tsc --noEmit && eslint .",
    "lint:fix": "tsc --noEmit && eslint . --fix",
    "prettier": "prettier ./src/**/*.ts --write",
    "prettier:check": "prettier ./src/**/*.ts --check",
    "postinstall": "echo 0",
    "audit": "yarn npm audit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reventex/reventex.git"
  },
  "keywords": [
    "eventsourcing",
    "reactive",
    "functional",
    "typescript",
    "ddd",
    "state",
    "state manager",
    "es"
  ],
  "author": "Mr.Cheater (Anton Zhukov)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/reventex/reventex/issues"
  },
  "homepage": "https://github.com/reventex/reventex#readme",
  "dependencies": {
    "is-promise": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.33.0",
    "@tsconfig/recommended": "^1.0.10",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitest/coverage-v8": "^4.0.0-beta.8",
    "eslint": "^9.33.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^4.0.0-alpha.12",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^4.0.0-beta.8"
  },
  "packageManager": "yarn@4.9.2"
}
